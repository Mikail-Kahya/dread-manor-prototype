--- !u!1001 &2026343110
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1661962367}
    m_Modifications:
    - target: {fileID: 1207136054564462740, guid: 164ce2d1953604440ba53c69b10bd709, type: 3}
      propertyPath: m_Name
      value: Letter
      objectReference: {fileID: 0}
    - target: {fileID: 3678846242783593945, guid: 164ce2d1953604440ba53c69b10bd709, type: 3}
      propertyPath: 'm_Materials.Array.data[0]'
      value: 
      objectReference: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
    - target: {fileID: 3989686592460957123, guid: 164ce2d1953604440ba53c69b10bd709, type: 3}
      propertyPath: m_text
      value: "Slowly my mind is fading. Soon enough I won\u2019t even be able to recognize my own name. If you read this, your name is Hendricks. Every day of research results in more of my memories fading, I can barely remember the voice of my wife.\n\r\nThe research is going well, but I can\u2019t seem to remember the code anymore. I have scrawled the numbers in places so I won\u2019t forget. There is one behind the portrait of my wife, one on the back of this letter, the next one is only visible once the fire is burning, and the last one can be found carved on the gem in the door."
      objectReference: {fileID: 0}
    - target: {fileID: 3989686592460957123, guid: 164ce2d1953604440ba53c69b10bd709, type: 3}
      propertyPath: m_sharedMaterial
      value: 
      objectReference: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
